# Frontend / Vite (set in .env.local for local dev and in Vercel for Production + Preview)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Local Convex CLI (set automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=

# Vercel CI deploy key (set in Vercel Environment Variables only; never commit secrets)
CONVEX_DEPLOY_KEY=

# Convex Dashboard -> Settings -> Environment Variables (set in Convex, NOT in Vercel):
# SITE_URL=https://hubdextracker.vercel.app
# AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
# JWT_PRIVATE_KEY=(generated via `npx @convex-dev/auth`)
# JWKS=(generated via `npx @convex-dev/auth`)